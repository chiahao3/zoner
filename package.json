{
  "name": "zoner",
  "version": "0.1.0",
  "private": true,
  "description": "Browser tool for tilting crystals to zone axes: synced real-space view, diffraction pattern, MEP-style images and a resolution stereogram.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node bench/e2e.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
